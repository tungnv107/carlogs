# Copy as .env; set private credentials outside Git.
DATABASE_URL="postgresql://vehicle:local-dev-only@localhost:5432/vehicle_expenses?schema=public"
AUTH_SECRET="replace-with-random-at-least-32-byte-secret"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
UPLOAD_DIR="./uploads"
REMINDER_JOB_SECRET="replace-with-independent-random-secret-at-least-32-characters"
# Local Docker database password; must match local DATABASE_URL above.
POSTGRES_PASSWORD="local-dev-only"
# Production compose.yaml database settings: replace password and use a separate
# DATABASE_URL with hostname db and a URL-encoded copy of this password.
DB_USER="vehicle"
DB_PASSWORD="replace-with-strong-database-password"
DB_NAME="vehicle_expenses"
