{
  "name": "carlog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --require=./scripts/windows-realpath-compat.cjs ./node_modules/next/dist/bin/next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint app components lib modules prisma auth.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "vitest run",
    "db:generate": "prisma generate",
    "db:up": "node scripts/start-dev-db.cjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "stats:users": "node scripts/usage-stats.cjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.16.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
